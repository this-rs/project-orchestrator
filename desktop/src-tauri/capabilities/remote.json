{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-backend",
  "description": "Permissions for the main window when served from the embedded backend (http://localhost:6600). Required because OIDC/SSO callback navigates the webview to http://localhost:{port}/auth/callback, after which the window URL is a remote HTTP origin instead of tauri://localhost. All Tauri IPC (plugin invokes, event listeners) needs explicit remote permission. Application commands are granted one by one (allow-<command>): the web app gets the ones it calls and nothing else.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "opener:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:tray:default",
    "dialog:default",
    "dialog:allow-open",
    "websocket:default",
    "allow-get-server-port",
    "allow-test-connection-detailed",
    "allow-open-url",
    "allow-pick-directory",
    "allow-restart-app",
    "allow-generate-config",
    "allow-read-config",
    "allow-detect-shell-path",
    "allow-check-cli-status",
    "allow-install-cli",
    "allow-setup-claude-code",
    "allow-verify-oidc-discovery",
    "allow-check-embedding-model",
    "allow-download-embedding-model",
    "allow-test-embedding-endpoint",
    "allow-check-docker",
    "allow-open-docker-desktop",
    "allow-test-connection",
    "allow-check-update",
    "allow-install-update",
    "allow-enable-modern-window-style",
    "allow-webview-log"
  ]
}
