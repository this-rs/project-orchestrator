# Native libraries the release links dynamically: ONE line per library, and the only place a
# version is written. release.yml, .github/workflows/prebuilt-libs.yml and scripts/prebuilt-lib.sh
# all read this file. Bumping a version here is the whole operation: the prebuilt channel fetches
# (or builds) the new one, and nothing else has to change.

# ONNX Runtime, linked by `ort`/fastembed for the local embeddings.
#   - It must serve the API `ort` asks for. fastembed 5.17.2 turns on ort's `api-24`; ort PANICS at
#     start on a runtime that serves less, so scripts/check-ort-api.sh checks the thing we SHIP.
#     1.23.2 serves API 23 only (local embeddings cannot start); 1.24.2 serves 24.
#   - glibc floor of Microsoft's x64 archive: 2.27, below the 2.35 promise of check-os-floor.sh.
#   - Microsoft publishes nothing for macOS Intel from 1.24 on: that one is built by
#     scripts/build-onnxruntime-macos.sh and published to the library release (lib/ort-<version>).
ORT_VERSION=1.24.2

# What `ort` ASKS FOR at start-up: the highest `api-N` feature of ort-sys, turned on by fastembed
# (=2.0.0-rc.12, api-24 in fastembed 5.17.2). scripts/check-ort-api.sh compares it with what the
# runtime we ship actually serves, and refuses a runtime that serves less.
ORT_REQUIRED_API=24
