# Neo4j configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=orchestrator123

# Meilisearch configuration
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=orchestrator-meili-key-change-me

# Server configuration
SERVER_PORT=8080
WORKSPACE_PATH=.

# NATS message broker (optional — enables inter-process event sync)
# Required when running multiple instances (dev + desktop) simultaneously.
# If unset, events are local-only (single-instance mode).
# NATS_URL=nats://localhost:4222

# Boot behaviour — what a restart relaunches (default: on)
# RESUME_ON_START=false keeps every agent asleep at boot: the chat turns the
# restart cut and the plan runs it interrupted are NOT relaunched, and the
# schedule and event triggers are not started. Use it whenever you start a COPY
# of a production database (a test, a migration check): the copy still holds the
# sessions that were live when it was taken, and the server would resume them.
# `false` or `0` turns it off; any other value, or unset, leaves it on.
# RESUME_ON_START=false

# Logging
RUST_LOG=info,project_orchestrator=debug

# Authentication (Google OAuth + JWT)
# Auth is configured in config.yaml (not via env vars).
# See config.yaml.example for the full auth section.
# If the auth section is absent from config.yaml, the server serves EVERY
# request anonymously, on all interfaces (0.0.0.0), and logs `AUTH DISABLED`
# at boot. Configure `auth` before exposing the host beyond a trusted machine.
