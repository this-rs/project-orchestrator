%% ---
%% PROUVE : ce que la couche de stockage PROMET au reste du backend.
%%   Un seul point de composition choisit un adaptateur ; partout ailleurs le code ne
%%   nomme que des traits. Chaque adaptateur DECLARE ses capacites, et /health les publie.
%%   Le perimetre de la promesse est borne par un controle executable, pas par une note.
%% ---
%% SOURCES LUES :
%%   src/storage.rs            — StorageBackend::from_config, select_backend, BackendKind {Default, Memory, Obrain}
%%   src/obrain/mod.rs         — ObrainGraphStore (ecrivain unique + index sous verrou court, fsync WAL par ecriture, flush complet pour les valeurs en colonne blob, garde-fou d ouverture), NonPorte, magasins qui refusent
%%   src/obrain/project.rs     — ProjectStore porte par l API Rust d obrain, creation atomique par ordre (marqueur brouillon pose en premier, retire en dernier), index Uuid vers NodeId reconstruit a l ouverture qui repare et met en quarantaine
%%   build/refus_obrain.rs     — genere, depuis les contrats, les impl de refus des traits non portes ; echoue si un impl ecrit a la main omet une methode
%%   src/neo4j/traits.rs       — trait GraphStore + StoreCapabilities (10 capacites)
%%   src/neo4j/trajectory.rs   — pool dedie + amorcage de l'index vectoriel, dans l'adaptateur
%%   src/api/handlers.rs       — /health publie storage_capabilities, garde le champ neo4j
%%   src/events/types.rs       — TransportState : l'etat du transport vu de l'exterieur
%%   xtask/src/storage_boundary.rs — le controle, ses modes et son fichier d'exceptions
%% ---
flowchart TD
    subgraph composition["point de composition unique"]
        CFG["Config<br/>storage.backend (defaut : adaptateur courant)"]
        FAB["StorageBackend::from_config()<br/>src/storage.rs"]
        CFG --> FAB
    end

    FAB --> G["Arc&lt;dyn GraphStore&gt;<br/>adaptateur graphe"]
    FAB --> S["Arc&lt;dyn SearchStore&gt;<br/>adaptateur recherche"]
    FAB --> T["Arc&lt;dyn TrajectoryStore&gt;<br/>adaptateur trajectoires"]

    G --> CAPS["StoreCapabilities<br/>10 capacites declarees<br/>chacune justifiee dans le code"]
    T --> IDX["index vectoriel du domaine<br/>cree par l'adaptateur"]

    APP["managers, handlers, runner, CLI"] -. "ne nomment que des traits" .-> G
    APP -.-> S
    APP -.-> T

    subgraph obrain["backend obrain (feature obrain-backend, storage.backend = obrain)"]
        OG["ObrainGraphStore<br/>src/obrain/mod.rs<br/>base embarquee, PO ecrivain unique"]
        OP["ProjectStore porte<br/>src/obrain/project.rs<br/>API Rust, index Uuid vers NodeId"]
        OR["tout le reste : NonPorte<br/>impl generes par build/refus_obrain.rs<br/>depuis les contrats"]
        OG --> OP
        OG --> OR
    end
    FAB -- "BackendKind::Obrain<br/>chemin absolu : storage.obrain_path, sans defaut ;<br/>creation : storage.obrain_create seulement" --> OG
    OG -. "est un" .-> G
    OR -. "recherche et trajectoires refusent aussi :<br/>ni Neo4j ni Meilisearch ouverts" .-> S

    HEALTH["/health"] --> CAPS
    HEALTH --> TS["TransportState<br/>Disabled / Connected / Disconnected / Unknown"]

    CI["cargo xtask storage-boundary --strict"] -. "echoue si un pilote<br/>apparait hors adaptateur" .-> APP
    EXC["storage-boundary-exceptions.txt<br/>base gelee, ne peut que decroitre"] --- CI
