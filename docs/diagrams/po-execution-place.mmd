    PLAN["✅ ephemeral_worktree::plan<br/>dépôt = worktree PRINCIPAL ; base = origin/HEAD sinon HEAD, SHA figé ;<br/>X sous &lt;app&gt;/task-worktrees, jamais dans un worktree ; rien n'est créé<br/>test : the_place_is_planned_from_the_main_worktree_at_a_frozen_sha_outside_any_worktree"]
    BOOK["✅ PlacementBook::request<br/>idempotent (tâche, personne, dépôt) ; 4 par personne, 32 au total, 15 min<br/>journal : requested (sinon rien n'est gardé)<br/>test : requests_are_idempotent_and_bounded, the_place_waits_for_its_person_and_names_x_resolved_by_po"]
    AUTO{"✅ Rock'n roll : l'enveloppe lit le mode du parent (ceiling >= bypassPermissions/trust), demandeur = SESSION avec une personne devant<br/>le HARNAIS confirme pour le propriétaire : PlacementBook::confirm_for_owner (propriétaire, X exact relu du carnet)<br/>journal : confirmed, acteur = propriétaire, détail auto:bypassPermissions ; pas de carte, pas de POST<br/>test : in_bypass_the_harness_confirms_for_the_owner_and_the_audit_says_so, bypass_does_not_open_a_session_nobody_is_in_front_of,<br/>outside_bypass_the_delegation_still_waits_for_a_human_click, the_harness_confirms_only_for_the_session_owner_and_the_exact_path"}
    ASK["🟠 202 confirmation_required + événement execution_place_confirmation_required"]

    CONF{"✅ POST /api/execution-places/{id}/confirm {path: X}<br/>middleware : mutation réservée à un humain ; handler : jeton agent refusé ;<br/>PlacementBook::confirm : une PERSONNE, le propriétaire, X exact<br/>test : an_agent_token_cannot_confirm_for_its_person, an_agent_token_never_confirms_even_for_its_own_person,<br/>the_confirmation_must_name_the_place_po_resolved, human_only_mutation_matches_whole_segments_only"}
    REF["✅ 403 not_a_person / not_the_owner, 409 mismatch<br/>la question reste en attente"]
    AUD["✅ journal : confirmed (qui, X, quand, tâche) AVANT toute création<br/>échec d'écriture → rien n'est créé"]
    MAKE["✅ ephemeral_worktree::create<br/>git worktree add -b po/task-… X &lt;sha figé&gt;"]
    LAUNCH["⚪ launch_delegation (cwd = X)<br/>journal : launched (session)"]
    FAIL["✅ échec d'ouverture → launch_failed puis libération immédiate<br/>test : a_confirmed_place_is_audited_made_and_released_when_the_launch_fails"]
    DONE["🟠 tâche finie (résultat, échec, filet 1 h) → close_session → LaunchedPlace::finish"]
    REL{"✅ EphemeralWorktree::release<br/>modifs non commitées (non suivis compris) ? commits hors base et hors remotes (HEAD détaché compris) ? illisible ?"}
    KEPT["✅ GARDÉ avec sa branche + raison ; journal kept<br/>test : a_worktree_with_unpushed_commits_is_kept_with_its_branch,<br/>a_worktree_with_uncommitted_or_untracked_files_is_kept, a_detached_commit_in_the_worktree_is_unpushed_work_too"]
    GONE["✅ git worktree remove (sans --force) + branch -D ; journal removed<br/>test : a_clean_worktree_is_removed_with_its_branch, pushed_commits_do_not_keep_the_worktree"]
    REJ["✅ POST …/reject → journal rejected<br/>test : the_person_may_say_no"]
    READ["🟠 GET /api/tasks/{task}/execution-places — le journal, du plus ancien au plus récent"]
    LIST["✅ GET /api/execution-places?status=pending — placements en attente de la personne appelante<br/>personne seulement (jeton agent → 403) ; filtre owner = claims.sub côté serveur ;<br/>status=pending requis ; lit le PlacementBook en mémoire (un seul store, place_confirmation)<br/>test : list_pending_shows_only_the_callers_placements, list_pending_rejects_an_agent_token, list_pending_requires_status_pending"]

