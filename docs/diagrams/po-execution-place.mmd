    REQ["⚪ POST /api/plans/{plan}/tasks/{task}/delegate<br/>execution_place: ephemeral_worktree<br/>(enveloppe A17 appliquée au cwd demandé : po-spawn-envelope)"]
    WHO{"✅ person_in_front<br/>session qui demande : owner signé, pas de spawned_by<br/>appel direct : Claims::may_keep_lasting_approvals<br/>test : a_session_with_nobody_in_front_is_refused_without_a_question"}
