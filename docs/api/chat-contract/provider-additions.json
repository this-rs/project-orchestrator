          "global_rule",
          "default",
          "claude_code",
          "fallback"
        ]
      }
    },
    "CreateSessionRequest": {
      "provider": {
        "type": "string",
        "required": false,
        "doc": "id d'instance ; sur une session existante, un provider différent → 409 provider_conflict"
      }
    },
    "GET /api/chat/providers": {
      "query": {
        "project_slug": "string?"
      },
      "response": {
        "default_provider": "string | null",
        "providers": [
          {
            "id": "string",
            "kind": "string (claude_code | openai_compatible | codex | acp)",
            "label": "string",
            "builtin": "boolean",
            "is_default": "boolean",
            "allowed_for_project": "boolean | null (null sans project_slug)",
            "endpoint_origin": "string | null (jamais d'identifiant ; origine seule)",
            "credential": "string (vault:<nom> | env:<VAR> | none) — la référence, jamais la valeur",
            "health": {
              "state": "ok | auth_required | unreachable | cli_not_found | unknown",
              "code": "string? (code d'erreur ci-dessous)",
              "action": "string? (commande à lancer)",
              "checked_at": "string? (RFC 3339)"
            },
            "models": [
              {
                "id": "string",
                "alias": "string? (fast|default|deep|utility)",
                "capabilities": "Capabilities (par modèle)"
              }
            ]
          }
        ]
      }
    },
